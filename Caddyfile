:1234 {
	root * .
	file_server

	# CORS headers — required for cross-origin requests (basemap glyphs/sprites,
	# OSM US vector tiles) and for GeoJSON sources loaded from your local server
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
	}

	# Enable byte-range requests — required for PMTiles
	@pmtiles {
		path *.pmtiles
	}
	header @pmtiles Accept-Ranges bytes

	encode gzip
}
